{
  "extends": "markdownlint/style/prettier",
  "line_length": 80,
  "no-hard-tabs": false,
  "code-block-language": true,
  "code-blocks": {
    "line_length": 80
  },
  "no-multiple-blanks": {
    "maximum": 1
  },
  "list-indentation": {
    "indent": 2
  },
  "no-multiple-spaces": {
    "markers": true,
    "exceptions": []
  }
}
