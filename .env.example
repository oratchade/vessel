# Fabric Test Environment Configuration
# Copy this file to .env and customize as needed for local development
# All test credentials below are non-functional examples (safe to commit)

# MySQL Test Configuration
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=root_password
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=test_db
DB_MYSQL_CHARSET=utf8mb4

# PostgreSQL Test Configuration
DB_POSTGRES_USER=test_user
DB_POSTGRES_PASSWORD=test_password
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_DATABASE=test_db
DB_POSTGRES_SSLMODE=disable

# Microsoft SQL Server Test Configuration
DB_MSSQL_USER=sa
DB_MSSQL_PASSWORD=TestPassword123!
DB_MSSQL_HOST=localhost
DB_MSSQL_PORT=1433
DB_MSSQL_DATABASE=test_db
DB_MSSQL_ENCRYPT=disable
DB_MSSQL_TRUST_SERVER_CERT=true

# SQLite Test Configuration (no credentials required)
DB_SQLITE_PATH=:memory:

# Test Execution
# Set to true to run integration tests (requires Docker containers)
RUN_INTEGRATION_TESTS=false
